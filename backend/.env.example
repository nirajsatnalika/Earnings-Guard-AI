APP_NAME=EarningsGuard AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Set your Neon PostgreSQL connection string in backend/.env (NOT this file).
# This file is committed to source control as documentation only.
# Never commit real credentials.
#
# Format: postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST.neon.tech/REPLACE_DB?sslmode=require

# For local SQLite development (no Neon):
# DATABASE_URL=sqlite:///./earningsguard_dev.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: openai, gemini, fallback
AI_PROVIDER=fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
